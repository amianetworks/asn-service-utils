# DO NOT CHANGE FROM SERVICE REPOS. SET BY ASN `make set-version` ONLY.
ASN_RUNTIME_VERSION_DEV := 26.9.144
ASN_RUNTIME_VERSION_PRO := 26.9.4
ASN_BUILDER_GO_VERSION_DEV := 1.26.5
ASN_BUILDER_GO_VERSION_PRO := 1.26.5

ASN_RUNTIME_MODE ?= pro

ifeq ($(ASN_RUNTIME_MODE),dev)
ASN_RUNTIME_VERSION := $(ASN_RUNTIME_VERSION_DEV)
ASN_BUILDER_GO_VERSION := $(ASN_BUILDER_GO_VERSION_DEV)
else ifeq ($(ASN_RUNTIME_MODE),pro)
ASN_RUNTIME_VERSION := $(ASN_RUNTIME_VERSION_PRO)
ASN_BUILDER_GO_VERSION := $(ASN_BUILDER_GO_VERSION_PRO)
else
$(error ASN_RUNTIME_MODE must be dev or pro, got "$(ASN_RUNTIME_MODE)")
endif
